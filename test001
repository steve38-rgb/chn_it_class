const LABELS = ['A','B','C','D'];
let userAnswers = {};
let currentQ = 0;

// Build UI
function init() {
  buildPanelGrid();
  buildQuestions();
  showQ(0);
}

function buildPanelGrid() {
  const grid = document.getElementById('panel-grid');
  QUESTIONS.forEach((q, i) => {
    const dot = document.createElement('div');
    dot.className = 'q-dot';
    dot.id = `dot-${i}`;
    dot.innerHTML = `<span class="qnum">${q.id}</span><span class="qans" id="dot-ans-${i}"></span>`;
    dot.onclick = () => goToQ(i);
    grid.appendChild(dot);
  });
}

function buildQuestions() {
  const main = document.getElementById('main');
  QUESTIONS.forEach((q, i) => {
    const card = document.createElement('div');
    card.className = 'question-card';
    card.id = `qcard-${i}`;

    let contextHtml = '';
    if (q.context) {
      contextHtml = `<div class="q-context"><div class="q-context-label">▸ 情境描述</div>${q.context}</div>`;
    }

    const optionsHtml = q.options.map((opt, oi) => `
      <button class="option-btn" id="opt-${i}-${oi}" onclick="selectOption(${i},${oi})">
        <span class="opt-label">${LABELS[oi]}</span>
        <span>${opt}</span>
      </button>
    `).join('');

    const isLast = i === QUESTIONS.length - 1;
    const navHtml = `
      <div class="nav-row">
        <button class="nav-btn" onclick="goToQ(${i-1})" ${i===0?'disabled':''}>← 上一題</button>
        <span style="font-size:.78rem;color:var(--muted);">${i+1} / 50</span>
        ${isLast
          ? `<button class="submit-btn" onclick="confirmSubmit()">確認送出 →</button>`
          : `<button class="nav-btn primary" onclick="goToQ(${i+1})">下一題 →</button>`
        }
      </div>
    `;

    card.innerHTML = `
      <div class="q-meta">
        <div class="q-number">${String(q.id).padStart(2,'0')}</div>
        <div class="q-score">每題 2 分</div>
      </div>
      ${contextHtml}
      <div class="q-text">${q.text}</div>
      <div class="options-list">${optionsHtml}</div>
      ${navHtml}
    `;
    main.appendChild(card);
  });
}

function showQ(idx) {
  document.querySelectorAll('.question-card').forEach(c => c.classList.remove('active'));
  document.getElementById(`qcard-${idx}`).classList.add('active');
  currentQ = idx;
  updateDots();
  window.scrollTo({top:0, behavior:'smooth'});
}

function goToQ(idx) {
  if (idx < 0 || idx >= QUESTIONS.length) return;
  showQ(idx);
}

function selectOption(qIdx, optIdx) {
  const label = LABELS[optIdx];
  userAnswers[qIdx] = label;
  // Update buttons visual
  for (let i = 0; i < 4; i++) {
    const btn = document.getElementById(`opt-${qIdx}-${i}`);
    if (btn) btn.classList.toggle('selected', i === optIdx);
  }
  updateDots();
  updateProgress();
}

function updateDots() {
  QUESTIONS.forEach((q, i) => {
    const dot = document.getElementById(`dot-${i}`);
    const ansEl = document.getElementById(`dot-ans-${i}`);
    dot.classList.remove('answered','current');
    if (i === currentQ) dot.classList.add('current');
    else if (userAnswers[i]) dot.classList.add('answered');
    ansEl.textContent = userAnswers[i] ? userAnswers[i] : '';
  });
}

function updateProgress() {
  const count = Object.keys(userAnswers).length;
  document.getElementById('prog-bar').style.width = (count/50*100)+'%';
  document.getElementById('prog-label').textContent = `${count} / 50 題`;
}

function confirmSubmit() {
  const count = Object.keys(userAnswers).length;
  const unanswered = 50 - count;
  const msg = unanswered > 0
    ? `您還有 ${unanswered} 題尚未作答，確定要送出嗎？`
    : '您已完成所有題目，確定要送出嗎？';
  document.getElementById('modal-msg').textContent = msg;
  document.getElementById('submit-modal').classList.add('open');
}

function closeModal() {
  document.getElementById('submit-modal').classList.remove('open');
}

function doSubmit() {
  closeModal();
  showResult();
}

function showResult() {
  document.getElementById('main').style.display = 'none';
  document.getElementById('result-page').style.display = 'block';
  window.scrollTo({top:0, behavior:'smooth'});

  let correct = 0, wrong = 0, skip = 0;
  const wrongItems = [];

  QUESTIONS.forEach((q, i) => {
    const ua = userAnswers[i];
    if (!ua) { skip++; wrongItems.push({q, i, ua:'（未作答）'}); }
    else if (ua === q.answer) { correct++; }
    else { wrong++; wrongItems.push({q, i, ua}); }
  });

  const score = correct * 2;
  document.getElementById('res-score').textContent = score;
  document.getElementById('res-correct').textContent = correct;
  document.getElementById('res-wrong').textContent = wrong;
  document.getElementById('res-skip').textContent = skip;
  document.getElementById('res-sub').textContent = `答對 ${correct} 題，共 ${score} 分`;

  const wl = document.getElementById('wrong-list');
  if (wrongItems.length === 0) {
    wl.innerHTML = '<div style="text-align:center;padding:30px;color:var(--correct);font-family:Noto Serif TC,serif;font-size:1.1rem;">🎉 全部答對！完美滿分！</div>';
  } else {
    wl.innerHTML = `<h3>錯誤與未答題目 <span class="badge">${wrongItems.length} 題</span></h3>`;
    wrongItems.forEach(({q, i, ua}) => {
      const isSkip = ua === '（未作答）';
      const correctOpt = q.options[LABELS.indexOf(q.answer)];
      const myOpt = isSkip ? '未作答' : q.options[LABELS.indexOf(ua)];
      wl.innerHTML += `
        <div class="wrong-item">
          <div class="wi-meta">
            <span class="wi-qnum">第 ${q.id} 題</span>
          </div>
          <div class="wi-text">${q.text}</div>
          <div class="wi-answers">
            <span class="wi-chip my">您的答案：${isSkip ? '未作答' : ua+'（'+myOpt+'）'}</span>
            <span class="wi-chip correct">正確答案：${q.answer}（${correctOpt}）</span>
          </div>
        </div>
      `;
    });
  }
}

function resetQuiz() {
  userAnswers = {};
  currentQ = 0;
  document.getElementById('result-page').style.display = 'none';
  document.getElementById('main').style.display = 'block';
  // Reset all option buttons
  QUESTIONS.forEach((q, i) => {
    for (let oi = 0; oi < 4; oi++) {
      const btn = document.getElementById(`opt-${i}-${oi}`);
      if (btn) { btn.className = 'option-btn'; btn.disabled = false; }
    }
  });
  updateDots();
  updateProgress();
  document.getElementById('prog-bar').style.width = '0%';
  document.getElementById('prog-label').textContent = '0 / 50 題';
  showQ(0);
}

init();
</script>
