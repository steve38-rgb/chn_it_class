<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>臺北市115學年度 國民小學教師甄選 模擬考題</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;700&family=Noto+Sans+TC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1a2e;
    --paper: #faf7f2;
    --paper2: #f3ede3;
    --accent: #c0392b;
    --accent2: #8b1a1a;
    --gold: #c9973a;
    --muted: #7a7060;
    --correct: #2e7d4f;
    --wrong: #c0392b;
    --panel-w: 280px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Noto Sans TC', sans-serif;
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── Header ── */
  header {
    background: var(--ink);
    color: var(--paper);
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 200;
    border-bottom: 3px solid var(--gold);
  }
  header .title-block h1 {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: .05em;
  }
  header .title-block p {
    font-size: .72rem;
    color: var(--gold);
    margin-top: 2px;
    letter-spacing: .08em;
  }
  .progress-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .progress-bar-outer {
    width: 180px;
    height: 6px;
    background: rgba(255,255,255,.15);
    border-radius: 3px;
    overflow: hidden;
  }
  .progress-bar-inner {
    height: 100%;
    background: var(--gold);
    border-radius: 3px;
    transition: width .4s ease;
    width: 0%;
  }
  .progress-label {
    font-size: .78rem;
    color: rgba(255,255,255,.7);
    white-space: nowrap;
  }

  /* ── Floating side panel ── */
  #side-panel {
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: var(--panel-w);
    background: var(--ink);
    color: var(--paper);
    z-index: 300;
    display: flex;
    flex-direction: column;
    transform: translateX(calc(-1 * var(--panel-w) + 16px));
    transition: transform .35s cubic-bezier(.4,0,.2,1);
    box-shadow: 4px 0 24px rgba(0,0,0,.35);
  }
  #side-panel:hover, #side-panel.pinned {
    transform: translateX(0);
  }
  .panel-tab {
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    background: var(--ink);
    color: var(--gold);
    font-size: .7rem;
    letter-spacing: .15em;
    padding: 14px 8px;
    border-radius: 0 6px 6px 0;
    cursor: default;
    font-family: 'Noto Serif TC', serif;
    font-weight: 700;
    border-right: 2px solid var(--gold);
  }
  .panel-header {
    padding: 24px 18px 12px;
    border-bottom: 1px solid rgba(255,255,255,.12);
    flex-shrink: 0;
  }
  .panel-header h2 {
    font-family: 'Noto Serif TC', serif;
    font-size: .9rem;
    color: var(--gold);
    letter-spacing: .1em;
  }
  .panel-header p {
    font-size: .7rem;
    color: rgba(255,255,255,.45);
    margin-top: 4px;
  }
  .panel-grid {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    align-content: start;
  }
  .panel-grid::-webkit-scrollbar { width: 4px; }
  .panel-grid::-webkit-scrollbar-thumb { background: rgba(255,255,255,.2); border-radius: 2px; }
  .q-dot {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 6px;
    border: 1.5px solid rgba(255,255,255,.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: .62rem;
    color: rgba(255,255,255,.5);
    transition: all .2s;
    gap: 2px;
    padding: 2px;
  }
  .q-dot:hover { border-color: var(--gold); color: var(--gold); }
  .q-dot .qnum { font-size: .68rem; font-weight: 600; }
  .q-dot .qans { font-size: .6rem; color: var(--gold); font-family: 'Noto Serif TC', serif; }
  .q-dot.answered {
    background: rgba(201,151,58,.12);
    border-color: rgba(201,151,58,.5);
    color: rgba(255,255,255,.85);
  }
  .q-dot.current {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }
  .q-dot.current .qans { color: var(--ink); }

  /* ── Main content ── */
  #main {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 100px;
  }

  /* ── Question card ── */
  .question-card {
    display: none;
    animation: fadeSlide .35s ease;
  }
  .question-card.active { display: block; }
  @keyframes fadeSlide {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .q-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
  }
  .q-number {
    font-family: 'Noto Serif TC', serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--paper2);
    line-height: 1;
    -webkit-text-stroke: 2px var(--accent);
  }
  .q-score {
    font-size: .72rem;
    color: var(--muted);
    background: var(--paper2);
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid #ddd6c8;
  }

  .q-context {
    background: linear-gradient(135deg, var(--ink) 0%, #2c2c4a 100%);
    color: rgba(255,255,255,.9);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 18px;
    font-size: .82rem;
    line-height: 1.8;
    border-left: 4px solid var(--gold);
  }
  .q-context-label {
    font-size: .68rem;
    color: var(--gold);
    letter-spacing: .12em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .q-text {
    font-size: .95rem;
    line-height: 1.9;
    margin-bottom: 24px;
    color: var(--ink);
    font-weight: 500;
    padding: 20px 22px;
    background: white;
    border-radius: 10px;
    border: 1.5px solid #e8e0d4;
    box-shadow: 0 2px 12px rgba(0,0,0,.05);
  }

  .options-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }
  .option-btn {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 10px;
    border: 2px solid #e3ddd4;
    background: white;
    cursor: pointer;
    text-align: left;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: .88rem;
    line-height: 1.7;
    color: var(--ink);
    transition: all .2s;
    box-shadow: 0 1px 4px rgba(0,0,0,.04);
  }
  .option-btn:hover:not(:disabled) {
    border-color: var(--accent);
    background: #fff5f5;
    transform: translateX(3px);
  }
  .option-btn .opt-label {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--paper2);
    border: 1.5px solid #ccc4b8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .78rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
    transition: all .2s;
    font-family: 'Noto Serif TC', serif;
  }
  .option-btn.selected {
    border-color: var(--accent);
    background: #fff8f8;
  }
  .option-btn.selected .opt-label {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }
  /* Result states */
  .option-btn.correct-ans {
    border-color: var(--correct);
    background: #f0faf4;
  }
  .option-btn.correct-ans .opt-label {
    background: var(--correct);
    border-color: var(--correct);
    color: white;
  }
  .option-btn.wrong-ans {
    border-color: var(--wrong);
    background: #fff5f5;
  }
  .option-btn.wrong-ans .opt-label {
    background: var(--wrong);
    border-color: var(--wrong);
    color: white;
  }
  .option-btn:disabled { cursor: default; transform: none; }

  /* ── Navigation ── */
  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .nav-btn {
    padding: 11px 28px;
    border-radius: 8px;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-family: 'Noto Serif TC', serif;
    font-size: .85rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: .05em;
    transition: all .2s;
  }
  .nav-btn:hover:not(:disabled) { background: var(--ink); color: var(--paper); }
  .nav-btn:disabled { opacity: .3; cursor: default; }
  .nav-btn.primary {
    background: var(--ink);
    color: var(--gold);
    border-color: var(--ink);
  }
  .nav-btn.primary:hover { background: #0d0d1e; }
  .submit-btn {
    padding: 13px 36px;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: white;
    font-family: 'Noto Serif TC', serif;
    font-size: .9rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: .08em;
    transition: all .2s;
    box-shadow: 0 4px 16px rgba(192,57,43,.35);
  }
  .submit-btn:hover { background: var(--accent2); transform: translateY(-1px); }

  /* ── Result page ── */
  #result-page {
    display: none;
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 100px;
    animation: fadeSlide .4s ease;
  }
  .result-hero {
    text-align: center;
    padding: 40px 20px;
    background: var(--ink);
    border-radius: 16px;
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
  }
  .result-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 40%, rgba(201,151,58,.15) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 60%, rgba(192,57,43,.1) 0%, transparent 60%);
  }
  .result-hero h2 {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.1rem;
    color: var(--gold);
    letter-spacing: .15em;
    margin-bottom: 16px;
    position: relative;
  }
  .score-display {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .score-main {
    font-family: 'Noto Serif TC', serif;
    font-size: 5rem;
    font-weight: 700;
    color: white;
    line-height: 1;
  }
  .score-total {
    font-size: 1.4rem;
    color: rgba(255,255,255,.5);
    font-family: 'Noto Serif TC', serif;
  }
  .score-sub {
    font-size: .8rem;
    color: rgba(255,255,255,.55);
    margin-top: 10px;
    letter-spacing: .05em;
  }

  .result-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 40px;
  }
  .stat-card {
    background: white;
    border-radius: 10px;
    padding: 18px;
    text-align: center;
    border: 1.5px solid #e8e0d4;
  }
  .stat-card .val {
    font-family: 'Noto Serif TC', serif;
    font-size: 2rem;
    font-weight: 700;
  }
  .stat-card .lbl { font-size: .72rem; color: var(--muted); margin-top: 4px; }
  .stat-card.green .val { color: var(--correct); }
  .stat-card.red .val { color: var(--wrong); }
  .stat-card.blue .val { color: #2563eb; }

  .wrong-list h3 {
    font-family: 'Noto Serif TC', serif;
    font-size: 1rem;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .wrong-list h3 .badge {
    background: var(--accent);
    color: white;
    font-size: .7rem;
    padding: 3px 10px;
    border-radius: 20px;
    font-family: 'Noto Sans TC', sans-serif;
  }

  .wrong-item {
    background: white;
    border-radius: 10px;
    padding: 18px 20px;
    margin-bottom: 14px;
    border: 1.5px solid #e8e0d4;
    border-left: 4px solid var(--accent);
  }
  .wrong-item .wi-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .wi-qnum {
    font-family: 'Noto Serif TC', serif;
    font-size: .78rem;
    color: var(--accent);
    font-weight: 700;
    background: #fff5f5;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid #f5c6c1;
  }
  .wrong-item .wi-text {
    font-size: .85rem;
    line-height: 1.75;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .wi-answers {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .wi-chip {
    font-size: .78rem;
    padding: 5px 14px;
    border-radius: 20px;
    font-family: 'Noto Serif TC', serif;
    font-weight: 600;
  }
  .wi-chip.my { background: #fff5f5; color: var(--wrong); border: 1.5px solid var(--wrong); }
  .wi-chip.correct { background: #f0faf4; color: var(--correct); border: 1.5px solid var(--correct); }

  .retry-btn {
    display: block;
    width: 100%;
    padding: 15px;
    border-radius: 10px;
    border: none;
    background: var(--ink);
    color: var(--gold);
    font-family: 'Noto Serif TC', serif;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: .1em;
    margin-top: 32px;
    transition: all .2s;
  }
  .retry-btn:hover { background: #0d0d1e; }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-thumb { background: #ccc4b4; border-radius: 3px; }

  /* ── Custom Modal ── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    z-index: 999;
    align-items: center;
    justify-content: center;
  }
  .modal-overlay.open { display: flex; }
  .modal-box {
    background: var(--paper);
    border-radius: 14px;
    padding: 36px 32px 28px;
    max-width: 380px;
    width: 90%;
    box-shadow: 0 20px 60px rgba(0,0,0,.35);
    text-align: center;
  }
  .modal-box h3 {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.1rem;
    margin-bottom: 12px;
    color: var(--ink);
  }
  .modal-box p {
    font-size: .88rem;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .modal-btns { display: flex; gap: 12px; justify-content: center; }
  .modal-btns button {
    padding: 10px 28px;
    border-radius: 8px;
    font-family: 'Noto Serif TC', serif;
    font-size: .88rem;
    font-weight: 700;
    cursor: pointer;
    border: 2px solid var(--ink);
    transition: all .2s;
  }
  .modal-cancel { background: transparent; color: var(--ink); }
  .modal-cancel:hover { background: var(--ink); color: var(--paper); }
  .modal-confirm { background: var(--accent); color: white; border-color: var(--accent); }
  .modal-confirm:hover { background: var(--accent2); border-color: var(--accent2); }
</style>
</head>
<body>

<header>
  <div class="title-block">
    <h1>臺北市115學年度 公立國民小學教師甄選</h1>
    <p>初試專門類科知能試題 — 普通科 ／ 50題 × 2分 ／ 共100分</p>
  </div>
  <div class="progress-wrap">
    <div class="progress-bar-outer">
      <div class="progress-bar-inner" id="prog-bar"></div>
    </div>
    <span class="progress-label" id="prog-label">0 / 50 題</span>
  </div>
</header>

<!-- Side Panel -->
<div id="side-panel">
  <div class="panel-tab">題目導航</div>
  <div class="panel-header">
    <h2>題目導航</h2>
    <p>點選題號快速跳題</p>
  </div>
  <div class="panel-grid" id="panel-grid"></div>
</div>

<!-- Quiz Area -->
<div id="main">
  <!-- Questions injected here -->
</div>

<!-- Custom Confirm Modal -->
<div class="modal-overlay" id="submit-modal">
  <div class="modal-box">
    <h3>確認送出答案</h3>
    <p id="modal-msg">確定要送出嗎？</p>
    <div class="modal-btns">
      <button class="modal-cancel" onclick="closeModal()">繼續作答</button>
      <button class="modal-confirm" onclick="doSubmit()">確認送出</button>
    </div>
  </div>
</div>

<!-- Result Page -->
<div id="result-page">
  <div class="result-hero">
    <h2>✦ 測驗結果 ✦</h2>
    <div class="score-display">
      <span class="score-main" id="res-score">0</span>
      <span class="score-total">/ 100</span>
    </div>
    <div class="score-sub" id="res-sub"></div>
  </div>
  <div class="result-stats">
    <div class="stat-card green"><div class="val" id="res-correct">0</div><div class="lbl">答對題數</div></div>
    <div class="stat-card red"><div class="val" id="res-wrong">0</div><div class="lbl">答錯題數</div></div>
    <div class="stat-card blue"><div class="val" id="res-skip">0</div><div class="lbl">未作答題數</div></div>
  </div>
  <div class="wrong-list" id="wrong-list"></div>
  <button class="retry-btn" onclick="resetQuiz()">↺ 重新作答</button>
</div>

<script>
const QUESTIONS = [
  {
    id:1,
    text:"正式特教學生需要輔導老師的協助時，以下何者非輔導教師工作項目？",
    options:["合作諮詢","個別晤談","參加個別化教育計畫","問題行為的功能評量及分析"],
    answer:"D"
  },
  {
    id:2,
    text:"布魯姆(Bloom)的認知領域目標分類修訂版中，「創造」層次是指？",
    options:["將資訊分解成小部分並理解其結構。","根據標準進行科學判斷與客觀評論。","將各元素整合，形成新的結構或模式。","記住並能回憶出事實資料與追溯來源。"],
    answer:"C"
  },
  {
    id:3,
    text:"「青春期的起伏像雲霄飛車」請問此概念較屬創造思考中的哪一種類比方法？",
    options:["擬人類比","象徵類比","屬性類比","直接類比"],
    answer:"D"
  },
  {
    id:4,
    text:"針對低年級的小學生進行小團體，下列何者不是合適的策略？",
    options:["兒童的狀態多樣，團體的規模應該小一些。","需要更高度的結構化，以利兒童學習。","兒童專注力有限，所以團體時間需要拉長。","考量到兒童的參與情形，團體歷程可能需要更短。"],
    answer:"C"
  },
  {
    id:5,
    text:"依循現行《學校訂定教師輔導與管教學生辦法注意事項》的規定，學校在訂定教師輔導與管教學生辦法時，應召開會議討論。對於國民中小學來說，學生代表宜占全體會議人數的比例為何？",
    options:["五分之一以上","十分之一以上","十五分之一以上","二十分之一以上"],
    answer:"B"
  },
  {
    id:6,
    text:"在國小帶領人際關係小團體，以下何者不是初始期階段的主要任務？",
    options:["成員互相認識","介紹人際團體的性質","建立人際團體規範","分享自己的人際優點"],
    answer:"D"
  },
  {
    id:7,
    text:"下列哪一個概念最符合「當學生被教師或學校貼上『壞學生』的標籤後，逐漸內化此標籤，表現出更多偏差行為，最終真的成為壞學生」的現象？",
    options:["比馬龍效應(Pygmalion Effect)","霍桑效應(Hawthorne Effect)","自我應驗預言(Self-fulfilling Prophecy)","蝴蝶效應(Butterfly Effect)"],
    answer:"A"
  },
  {
