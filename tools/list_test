    font-size: 13px;
    color: var(--ink-light);
    cursor: pointer;
    transition: all .2s;
    letter-spacing: 0.5px;
  }
  .filter-btn:hover, .filter-btn.active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .search-wrap {
    position: relative;
    flex: 1;
    max-width: 260px;
    min-width: 160px;
  }
  .search-wrap input {
    width: 100%;
    padding: 7px 14px 7px 34px;
    border: 1.5px solid var(--border);
    background: var(--paper);
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 13px;
    color: var(--ink);
    outline: none;
    transition: border-color .2s;
    border-radius: 2px;
  }
  .search-wrap input:focus { border-color: var(--ink); }
  .search-wrap::before {
    content: '🔍';
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    pointer-events: none;
