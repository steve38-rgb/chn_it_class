      rgba(255,255,255,0.02) 40px,
      rgba(255,255,255,0.02) 80px
    );
  }
  .hero-badge {
    display: inline-block;
    border: 1.5px solid var(--gold-light);
    color: var(--gold-light);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 4px 14px;
    margin-bottom: 18px;
    position: relative;
  }
  .hero h1 {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(22px, 4vw, 36px);
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1.4;
    position: relative;
    margin-bottom: 12px;
  }
  .hero p {
    font-size: 14px;
    color: rgba(250,248,243,0.65);
    letter-spacing: 1px;
    position: relative;
  }
  .seal-line {
    width: 60px;
    height: 3px;
    background: var(--seal);
    margin: 18px auto 0;
    position: relative;
  }

  /* ── Controls ── */
  .controls {
    background: var(--cream);
