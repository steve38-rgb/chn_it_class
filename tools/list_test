<script>
  let currentType = 'all';

  function filterCards() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    applyFilters(query, currentType);
  }

  function filterType(type, btn) {
    currentType = type;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const query = document.getElementById('searchInput').value.toLowerCase();
    applyFilters(query, type);
  }

  function applyFilters(query, type) {
    const cards = document.querySelectorAll('.card');
    let count = 0;
    cards.forEach(card => {
      const name = card.dataset.name.toLowerCase();
      const ctype = card.dataset.type;
      const region = card.dataset.region;
      const matchName = name.includes(query);
      const matchType = type === 'all' || ctype === type ||
        (type === 'north' && region === 'north') ||
        (type === 'central' && region === 'central') ||
        (type === 'south' && region === 'south') ||
        (type === 'east' && region === 'east');
      if (matchName && matchType) {
        card.classList.remove('hidden');
        count++;
      } else {
        card.classList.add('hidden');
      }
    });
    document.getElementById('count-display').textContent = count;
  }
</script>
